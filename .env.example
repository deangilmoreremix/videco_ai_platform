# =============================================================================
# Stack: Netlify (SSR) + Supabase (Edge Functions, Storage, Postgres, Auth) + Muapi + OpenAI
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Edge Functions, Storage, Postgres, Auth, multi-tenant)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# OpenAI (Responses API + LLM)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key

# -----------------------------------------------------------------------------
# Muapi (video + image + audio + lip-sync + music + face-swap + upscale)
# Get a key: https://muapi.ai/access-keys
# -----------------------------------------------------------------------------
MUAPI_API_KEY=your_muapi_api_key

# -----------------------------------------------------------------------------
# Site URL (used for redirects / Supabase Auth invite callbacks)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Shared secrets
# -----------------------------------------------------------------------------
# Webhook shared secret: Muapi sends completion callbacks here. Must match
# what you set on the Edge Function deployment.
WEBHOOK_SHARED_SECRET=any-long-random-string

# App shared secret for internal API token verification
APP_SHARED_SECRET=any-long-random-string
