# =============================================================================
# Stack: Netlify (static SPA) + Supabase (Edge Functions, Storage, multi-tenant) + Muapi + OpenAI
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Edge Functions, Storage, Postgres, Auth, multi-tenant)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# OpenAI (Responses API + LLM)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key

# -----------------------------------------------------------------------------
# Muapi (video + image + audio + lip-sync + music + face-swap + upscale)
# Get a key: https://muapi.ai/access-keys
# -----------------------------------------------------------------------------
MUAPI_API_KEY=your_muapi_api_key

# -----------------------------------------------------------------------------
# Site URL (used for redirects / Supabase Auth invite callbacks)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# DEVELOPMENT
# =============================================================================
NODE_ENV=development

# =============================================================================
# MIGRATION 2026: MUAPI + OPENAI + NETLIFY + SUPABASE EDGE FUNCTIONS
# (See .kilo/plans/1779745006493-.md)
# =============================================================================
# Muapi.ai - primary image/video generation, lipsync, effects (replaces Sync.so + parts of Cloudinary)
MUAPI_API_KEY=your_muapi_api_key_here
MUAPI_WEBHOOK_SECRET=optional_muapi_webhook_signature_secret_if_provided

# OpenAI - Responses API (structured personalization/scripts), Realtime API (voice), LLM
# Note: OPENAI_API_KEY already listed above for studio; ensure it has Responses + Realtime access
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_MODEL_FOR_SCRIPTS=gpt-4o

# Supabase Edge Functions secrets (set via `supabase secrets set` or dashboard)
# SUPABASE_SERVICE_ROLE_KEY already defined above - required for server-side Edge calls

# Netlify (values auto-provided in Functions context; set in Netlify dashboard UI for local `netlify dev`)
# No additional keys required beyond standard build env

# Transitional / legacy (keep during phased migration, remove after cutover)
# CLOUDINARY_* (existing)
# SYNC_API_KEY (existing - will be replaced by Muapi)
# INNGEST_* (if Inngest still used temporarily)
