# =============================================================================
# VidecoAI Environment Variables
# Stack: Netlify (static SPA) + Supabase (Edge Functions, Storage, multi-tenant) + Muapi + OpenAI
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# =============================================================================

# Supabase (Edge Functions, Storage, Postgres, Auth, multi-tenant)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=

# OpenAI (Responses API + Realtime API + LLM)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_MODEL_FOR_SCRIPTS=gpt-4o

# Muapi (video + image + audio + lip-sync + face-swap + upscale)
MUAPI_API_KEY=
MUAPI_WEBHOOK_SECRET=
MUAPI_LIPSYNC_MODEL=
NEXT_PUBLIC_USE_MUAPI_AI=
NEXT_PUBLIC_MUAPI_AI=
USE_MUAPI_AI=

# Site URL (used for redirects / Supabase Auth invite callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Analytics / Tracking / UX
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_USETIFUL_TOKEN=

# Integrations
NEXT_PUBLIC_CALENDAR_BOOKING_URL=
NEXT_PUBLIC_SLACK_INVITE_URL=
NEXT_PUBLIC_CRISP_WEBSITE_ID=
NEXT_PUBLIC_PRODUCTLIFT_SIDEBAR_ID=
NEXT_PUBLIC_PRODUCTLIFT_WIDGET_ID=
NEXT_PUBLIC_ZAPIER_CLIENT_ID=
NEXT_PUBLIC_UPLOAD_CLIENT_KEY=

# Storage (S3-compatible uploads)
S3_UPLOAD_KEY=
S3_UPLOAD_SECRET=
S3_UPLOAD_BUCKET=
S3_UPLOAD_REGION=

# App Secrets
VIDECO_SECRET_KEY=
FEEDBACK_SECRET_KEY=
WEBHOOK_SECRET=

# Legacy / Transitional (still referenced in code, remove after migration)
NEXT_PUBLIC_RECORDING_URL=
SCREENSHOTONE_API_KEY=
INTERNAL_FUNCTION_SECRET=
WEBHOOK_SHARED_SECRET=
