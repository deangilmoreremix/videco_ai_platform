# =============================================================================
# Videco environment variables
# Stack: Next.js on Netlify + Supabase (Auth, Postgres, Storage, Edge
#        Functions) + Muapi (lip-sync, video) + OpenAI (voice, scripts).
#
# Two places hold configuration:
#   1. Netlify env vars / .env.local  -> the variables in this file
#   2. Supabase Edge Function secrets  -> listed at the bottom (set them with
#      `supabase secrets set ...`, never in this file or in Netlify)
# DO NOT commit .env.local.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public Storage bucket for recordings, voice samples and thumbnails.
NEXT_PUBLIC_VIDECO_MEDIA_BUCKET=videco-videos

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Brevo) -------------------------------------------------------------
BREVO_API_KEY=

# --- OpenAI (Next API routes: script personalisation) -------------------------
OPENAI_API_KEY=
OPENAI_MODEL_FOR_SCRIPTS=gpt-4o

# --- Optional integrations -------------------------------------------------------
# Pexels key for stock-video search in the editor (search is off when unset)
NEXT_PUBLIC_UPLOAD_CLIENT_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_USETIFUL_TOKEN=
NEXT_PUBLIC_CALENDAR_BOOKING_URL=
NEXT_PUBLIC_SLACK_INVITE_URL=
NEXT_PUBLIC_CRISP_WEBSITE_ID=
NEXT_PUBLIC_PRODUCTLIFT_SIDEBAR_ID=
NEXT_PUBLIC_PRODUCTLIFT_WIDGET_ID=
NEXT_PUBLIC_ZAPIER_CLIENT_ID=
NEXT_PUBLIC_RECORDING_URL=

# --- Internal secrets ----------------------------------------------------------
VIDECO_SECRET_KEY=
FEEDBACK_SECRET_KEY=

# =============================================================================
# Supabase Edge Function secrets (NOT Netlify):
#   supabase secrets set --project-ref <ref> \
#     MUAPI_API_KEY=...            # lip-sync + text-to-video (required)
#     OPENAI_API_KEY=...           # voices (TTS) + scripts (required)
#     WEBHOOK_SHARED_SECRET=...    # optional, with MUAPI_WEBHOOK_URL
#   Optional: MUAPI_LIPSYNC_MODEL (default sync-lipsync),
#             VIDECO_MEDIA_BUCKET (default videco-videos),
#             MUAPI_WEBHOOK_URL (public URL Muapi should call on completion)
# =============================================================================
